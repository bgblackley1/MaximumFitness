{
  "expo": {
    "name": "Maximum Fitness",
    "slug": "maximum-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "maximumfitness",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maximum_fitness_glasgow",
      "infoPlist": {
        "NSMotionUsageDescription": "Maximum Fitness reads your step count to display your daily activity progress on the home screen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.maximum_fitness_glasgow",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "637ffe1f-a419-4cef-9297-7fac7441681e"
      }
    },
    "owner": "maximumfitness"
  }
}
